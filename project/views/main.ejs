  <style>
    /* 전체 공통 CSS */
    * {
      margin: 0;
      padding: 0;
      text-decoration: none;
    }

    a {
      color: black;
    }

    body,
    html {
      font-family: "여기어때 잘난체 2 보통";
      height: 100%;
    }

    /* header */
    header {
      background-color: #0f4c81;
      border: 1px solid #D6DADB;
    }

    header {
      display: flex;
      align-items: center;
      height: 7vh;
      padding: 0 10px;
    }

    header #logoLink {
      /* color: #0f4c81; */
      color: white;
      font-family: 'Noto Sans KR';
      font-size: 24px;
      font-weight: bold;
    }

    #search1 {
      margin-left: auto;
      display: flex;
      align-items: center;
    }

    #searchBox1 {
      margin-left: 5px;
      padding: 5px;
      /* border: 1px solid black; */
      border-radius: 10px;

    }

    #mainSearch {
      margin-left: 3px;
      border-radius: 10px;
      width: 160px;
      height: 16px;
      padding: 2px;
      border: 1px solid #ababab;
    }

    /* header - 톱니바퀴 옵션토글 */
    #gearIcon1 {
      margin-left: 10px;
      cursor: pointer;
    }

    .options {
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      position: absolute;
      right: 10px;
      top: 7vh;
      background-color: white;
      border: 1px solid black;
      border-radius: 10px;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
      transition: max-height 0.5s ease-in-out, opacity 0.5s ease-in-out;
    }

    .options.show {
      max-height: 300px;
      /* 충분히 큰 값으로 설정 */
      opacity: 1;
    }

    .options div {
      padding: 10px;
      cursor: pointer;
    }

    .options div:hover {
      background-color: #f5f5f5;
    }

    /* main */
    main {
      display: flex;
      height: 93vh;
    }

    #sideBar {
      background-color: #ffffff;
      border: 1px solid #D6DADB;
      border-top: none;
      width: 300px;
      /* padding: 5px; */
      display: flex;
      flex-direction: column;
      height: 93vh;
      /* gap: 10px; */
    }


    #myProfile {
      display: flex;
      flex-direction: row;
      align-items: center;
      padding: 10px;
      justify-content: space-between;
      /* border: 1px solid black; */
      /* border-radius: 10px; */
      cursor: pointer;
      border-bottom: 1px solid #D6DADB;
    }

    #myProfile .profileBox {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
    }

    .sideCategory {
      display: flex;
      flex-direction: column;
      /* align-items: center; */
      /* padding: 10px; */
      /* border: 1px solid black; */
      border-radius: 10px;
      cursor: pointer;
    }

    .sideCategory span {
      margin-top: 10px;
      margin-left: 14px;
      /* align-items:start; */
      font-size: 14px;

    }

    .sideCategory .fa-list {
      margin-right: 5px;
      font-size: 14px;
    }

    .sideCategory .fa-arrow-down-wide-short {
      margin-right: 5px;
      font-size: 14px;
    }

    #gearIcon2 {
      display: none;
    }

    #myProfile ul {
      display: none;
    }

    #myProfile .fa-user {
      font-size: 24px;
      margin-left: 5px;
      margin-right: 5px;
      color: grey;
    }

    .sideCategory ul {
      border: 1px solid #D6DADB;
      width: 100%;
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      list-style: none;
      padding: 0;
      margin-top: 10px;
      transition: max-height 0.5s ease-in-out, opacity 0.5s ease-in-out;
    }

    .sideCategory.expanded {
      width: 100%;
    }

    .sideCategory.expanded ul {
      overflow-y: auto;
      justify-content: start;
      max-height: 200px;
      opacity: 1;
      width: 100%;
    }

    .sideCategory.expanded ul::-webkit-scrollbar {
      width: 4px;

    }

    .sideCategory.expanded ul::-webkit-scrollbar-thumb {
